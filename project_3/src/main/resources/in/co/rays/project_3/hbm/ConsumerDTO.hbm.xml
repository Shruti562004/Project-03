<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC 
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="in.co.rays.project_3.dto">

    <class name="ConsumerDTO" table="ST_CONSUMER">

        <!-- Primary Key -->
        <id name="id" type="java.lang.Long">
            <column name="ID"/>
            <generator class="increment"/>
        </id>

        <!-- Consumer Fields -->
        <property name="code" type="java.lang.String">
            <column name="CODE"/>
        </property>

        <property name="group" type="java.lang.String">
            <column name="GROUP_NAME"/>
        </property>

        <property name="name" type="java.lang.String">
            <column name="NAME"/>
        </property>

        <property name="status" type="java.lang.String">
            <column name="STATUS"/>
        </property>

        <!-- BaseDTO Fields -->
        <property name="createdBy" type="java.lang.String">
            <column name="CREATED_BY"/>
        </property>

        <property name="modifiedBy" type="java.lang.String">
            <column name="MODIFIED_BY"/>
        </property>

        <property name="createdDatetime" type="java.sql.Timestamp">
            <column name="CREATED_DATETIME"/>
        </property>

        <property name="modifiedDatetime" type="java.sql.Timestamp">
            <column name="MODIFIED_DATETIME"/>
        </property>

    </class>

</hibernate-mapping>