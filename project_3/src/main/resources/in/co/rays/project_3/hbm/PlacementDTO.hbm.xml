<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="in.co.rays.project_3.dto">

	<class name="PlacementDTO" table="ST_PLACEMENT">

		<id name="id" type="java.lang.Long">
			<column name="ID"/>
			<generator class="increment"/>
		</id>

		<property name="name" type="java.lang.String">
			<column name="NAME"/>
		</property>

		<property name="coordinates" type="java.lang.String">
			<column name="COORDINATES"/>
		</property>

		<property name="scale" type="java.lang.String">
			<column name="SCALE"/>
		</property>

		<property name="rotation" type="java.lang.String">
			<column name="ROTATION"/>
		</property>

		<!-- Common fields from BaseDTO -->

		<property name="createdBy" type="java.lang.String">
			<column name="CREATED_BY"/>
		</property>

		<property name="modifiedBy" type="java.lang.String">
			<column name="MODIFIED_BY"/>
		</property>

		<property name="createdDatetime" type="java.sql.Timestamp">
			<column name="CREATED_DATETIME"/>
		</property>

		<property name="modifiedDatetime" type="java.sql.Timestamp">
			<column name="MODIFIED_DATETIME"/>
		</property>

	</class>

</hibernate-mapping>