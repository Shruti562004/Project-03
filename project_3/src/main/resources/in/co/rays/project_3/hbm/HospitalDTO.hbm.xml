<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>

    <class name="in.co.rays.project_3.dto.HospitalDTO" table="ST_HOSPITAL">

        <id name="name" column="NAME" type="string">
            <generator class="assigned" />
        </id>

        <property name="disease" column="DISEASE" type="string" />

        <property name="docName" column="DOC_NAME" type="string" />

        <property name="bill" column="BILL" type="int" />
        
        <property name="createdBy" type="string">
			<column name="CREATED_BY" length="50"/>
		</property>

		<property name="modifiedBy" type="string">
			<column name="MODIFIED_BY" length="50"/>
		</property>

		<property name="createdDatetime" type="timestamp">
			<column name="CREATED_DATETIME"/>
		</property>

		<property name="modifiedDatetime" type="timestamp">
			<column name="MODIFIED_DATETIME"/>
		</property>

    </class>

</hibernate-mapping>