<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>

	<class name="in.co.rays.project_3.dto.InventoryDTO"
		table="ST_INVENTORY">

		<id name="id" type="long">
			<column name="ID" />
			<generator class="native" />
		</id>

		<property name="name" type="string">
			<column name="NAME" length="255" />
		</property>

		<property name="stock" type="int">
			<column name="STOCK" />
		</property>

		<property name="supplier" type="string">
			<column name="SUPPLIER" length="255" />
		</property>

		<property name="price" type="long">
			<column name="PRICE" />
		</property>

		<!-- BaseDTO Fields -->

		<property name="createdBy" type="string">
			<column name="CREATED_BY" length="255" />
		</property>

		<property name="modifiedBy" type="string">
			<column name="MODIFIED_BY" length="255" />
		</property>

		<property name="createdDatetime" type="timestamp">
			<column name="CREATED_DATETIME" />
		</property>

		<property name="modifiedDatetime" type="timestamp">
			<column name="MODIFIED_DATETIME" />
		</property>

	</class>

</hibernate-mapping>